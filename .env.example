# Canonical application origin without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Backward-compatible alias used by application metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public values used by browser and request-scoped server Supabase clients.
# For local development, copy API_URL and PUBLISHABLE_KEY (or ANON_KEY) from:
#   npx supabase status --output env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback; configure either this or the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only by same-origin DELETE /api/account. This key bypasses RLS and
# must exist only in trusted server runtime secrets. Never prefix it with
# NEXT_PUBLIC_, expose it to browser code, log it, or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
